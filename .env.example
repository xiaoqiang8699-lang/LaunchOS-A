NODE_ENV=development

WEB_PORT=3000
API_PORT=3001

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=launchos
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/launchos?schema=public
REDIS_URL=redis://127.0.0.1:6379

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=launchos
MINIO_SECRET_KEY=launchos-minio-secret
MINIO_BUCKET=launchos-artifacts

JWT_SECRET=
JWT_EXPIRES_IN=7d

NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

REAL_PAYMENTS_ENABLED=false
PAYMENT_TEST_REAL_ENABLED=false
ALIPAY_PRODUCTION_ENABLED=false
# Legacy business blocker for Path A test checkouts; does NOT select Sandbox provider.
# Formal Pro/Team Path B is gated by REAL_PAYMENTS_ENABLED. Provider env:
ALIPAY_PROVIDER_MODE=PRODUCTION
ALIPAY_SANDBOX_ONLY=true
ALIPAY_PRODUCTION_TEST_ENABLED=false
ALIPAY_PRODUCTION_TEST_WORKSPACE_ID=

DEPLOYMENT_MAX_RETRY=3

# mock = 测试模式（示例项目 / 沙箱）；docker = 真实 Docker Runtime
LAUNCHOS_RUNTIME_MODE=docker

# System domain (preferred). Legacy alias: LAUNCHOS_DOMAIN_ZONE
# Development fallback is launchos.app — do not treat it as a owned public domain.
LAUNCHOS_SYSTEM_DOMAIN=launchos.app
LAUNCHOS_DOMAIN_ZONE=launchos.app

# Public Gateway entry (must be the machine running LaunchOS Gateway, not the app server)
LAUNCHOS_GATEWAY_PUBLIC_IP=
LAUNCHOS_GATEWAY_SERVER_ID=

# Wildcard cert auto-renew window (days before expiry)
LAUNCHOS_CERT_RENEW_BEFORE_DAYS=30

# Local Gateway listen port (dev often 8080; public Gateway deploy uses 80)
GATEWAY_HTTP_PORT=8080
GATEWAY_HTTPS_PORT=8443
# Optional routes-file mode for remote Gateway
# GATEWAY_ROUTES_FILE=/opt/launchos-gateway/routes.json

# Do NOT put Aliyun DNS AccessKey/Secret in plaintext env for production automation.
# Use ProviderAccount type ALIYUN_DNS (AES-GCM encrypted). Separate from ECS ALIYUN.

# GitHub App (private repositories). Server-side only — never NEXT_PUBLIC_*.
# Create at: https://github.com/settings/apps/new
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Optional User OAuth pair (not required for installation flow)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
/**
 * GitHub App Setup / Callback URL — must be reachable by the user's browser.
 *
 * Actual route ownership:
 * 1) Browser-facing Setup URL / Callback URL → Web bridge
 *      /git/github/callback  (apps/web/src/app/git/github/callback/route.ts)
 * 2) Server handler → API
 *      /api/v1/git/github/callback  (GitHubConnectionsController)
 *
 * Local development:
 *   GITHUB_APP_CALLBACK_URL=http://localhost:3000/git/github/callback
 * External Alpha / Production (no localhost fallback):
 *   GITHUB_APP_CALLBACK_URL=https://web-launchos.zsaos.com/git/github/callback
 *   WEB_ORIGIN=https://web-launchos.zsaos.com
 * Also set GitHub App "Callback URL", "Setup URL", Homepage to the public web
 * URL above, and enable "Redirect on update". Webhook is not required for connect.
 */
GITHUB_APP_CALLBACK_URL=http://localhost:3000/git/github/callback

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-hangzhou
# Prefer ProviderAccount type ALIYUN (AES-GCM). Used for ECS + RDS + Redis (Step 25.3/25.4).
# Minimal RDS RAM actions (do NOT use AdministratorAccess):
# rds:CreateDBInstance, rds:DescribeDBInstanceAttribute, rds:DescribeDBInstances,
# rds:DescribeDBInstanceNetInfo, rds:DescribeAvailableClasses, rds:CreateDatabase,
# rds:CreateAccount, rds:GrantAccountPrivilege, rds:ModifySecurityIps,
# rds:AllocateInstancePublicConnection, rds:DeleteDBInstance,
# plus ecs:DescribeInstances/DescribeVpcs/DescribeVSwitches (network placement).
# Minimal Redis (kvstore) RAM actions — see docs/aliyun-redis-permissions.md:
# kvstore:CreateInstance, kvstore:DescribeInstances, kvstore:DescribeInstanceAttribute,
# kvstore:DescribeDBInstanceNetInfo, kvstore:DescribeAvailableResource,
# kvstore:ModifySecurityIps, kvstore:AllocateInstancePublicConnection, kvstore:DeleteInstance.
